{
  "name": "iextlibraries",
  "displayName": "iExternal libraries",
  "description": "PhpStorm-style External Libraries for VS Code: link folders or files from outside the project (WordPress core, shared plugins, SDKs) into the workspace for code completion and navigation.",
  "version": "0.1.0",
  "publisher": "itemcoder",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahbubur001/vscode-iextlibraries.git"
  },
  "bugs": {
    "url": "https://github.com/mahbubur001/vscode-iextlibraries/issues"
  },
  "homepage": "https://github.com/mahbubur001/vscode-iextlibraries#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "external libraries",
    "symlink",
    "phpstorm",
    "include path",
    "intellisense",
    "wordpress"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "iExt.addLibrary",
        "title": "Add External Library…",
        "category": "iExternal Libraries"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node test/e2e/run.js",
    "test": "npm run typecheck && npm run test:unit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  }
}
